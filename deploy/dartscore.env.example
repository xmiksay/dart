# dartscore server environment — install to /etc/dartscore.env (chmod 640).

# Postgres connection (required).
DATABASE_URL=postgres://dartscore:dartscore@localhost:5432/dartscore

# Web/WebSocket bind address.
BIND_ADDR=0.0.0.0:8080

# --- Camera capture feed (optional) ---
# Set DART_CAMERA to enable live scoring from the camera; omit to run the web
# game without a camera. See `dartscore capture --list` for indices.
DART_CAMERA=0
DART_EXPOSURE=200
# DART_BG_THRESHOLD=   # omit to auto-calibrate from the empty-board noise floor
# DART_BG_MIN_AREA=
# DART_BG_BLUR=

# Logging.
RUST_LOG=info
